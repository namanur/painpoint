# Environment variables for Lean Agent Orchestrator

# Database
# For local development:
PAINPOINT_DATABASE_URL=postgresql://localhost:5432/painpoint

# For production (4GB VPS):
# PAINPOINT_DATABASE_URL=postgresql://user:pass@localhost:5432/painpoint

# Pool settings (optimized for 4GB RAM)
PAINPOINT_POOL_MIN_SIZE=1
PAINPOINT_POOL_MAX_SIZE=5

# Validation settings
PAINPOINT_MAX_RETRIES_DEFAULT=3
PAINPOINT_MAX_RETRIES_LIMIT=5
